# ── Self-Healer CI Agent ──────────────────────────────────────────────
# Copy to .env and fill in real values.  .env is never committed.

# GitHub token — needs: repo, actions:write, read:org (for gh rerun + comments + branch push)
GH_TOKEN=

# Shared secret for GitHub Actions webhook HMAC verification (X-Webhook-Secret header)
CI_WEBHOOK_SECRET=

# SQLite database file (standalone — built into Node 22+, no server required)
DATABASE_URL=./data/self-healer.db

# ── LLM providers (the agent's "brain"; only these four exist) ────────
# Pick provider/model in self-healer.config.json (global default + per-repo override),
# or set defaults here:
# SELF_HEALER_LLM_PROVIDER=gemini     # gemini | openrouter | ollama | groq
# SELF_HEALER_LLM_MODEL=gemini-2.5-pro
# SELF_HEALER_CONFIG=./self-healer.config.json
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# SOR signing (HMAC secret for the audit hash chain — required for audit trail)
SOR_SIGNING_KEY=
SOR_KEY_ID=v1

# ── Optional ──────────────────────────────────────────────────────────
# CI_WEBHOOK_PORT=3457
# CI_POST_COMMENTS=0    # dry-run: skip posting CI comments (tests use this)

# Git identity for fix commits pushed to ci-fix/* branches
# SELF_HEALER_GIT_NAME=Self-Healer
# SELF_HEALER_GIT_EMAIL=self-healer@users.noreply.github.com
